[sub_resource type="GDScript" id="GDScript_sq3kl"]
script/source = "extends CharacterBase
var range:=200

@onready var lantern: Node2D = $Lantern

var aiming=false
var footstep_sounds = [
	 
preload(\"res://Entities/Breez/asset/pas 1/3.wav\")
,preload(\"res://Entities/Breez/asset/pas 1/4.wav\")
]
var jump_sounds =preload(\"res://Entities/Breez/asset/pas 1/jump2.wav\")
var land_sounds = [preload(\"res://Asset/Sprite/breez/landing/land 2.wav\"), preload(\"res://Asset/Sprite/breez/landing/land 3.wav\"), preload(\"res://Asset/Sprite/breez/landing/land 4.wav\")]
@onready var footstep: AudioStreamPlayer2D = $footstep
const FIRE_BREEZ = preload(\"res://Scenes/fireBreez.tscn\")

func play_footstep():
	footstep.stream = footstep_sounds[randi() % footstep_sounds.size()]
	footstep.play()
func play_jump():
	footstep.stream = jump_sounds
	footstep.play()
func play_landing():
	footstep.stream = land_sounds[randi() % land_sounds.size()]
	footstep.play()
func _ready() -> void:
	animation = $Animation
	shape = $\"../CollisionShape2D\"
	footstep.volume_db = -10
	
func aim(x,y):
	aiming = true
	
	var direction = Vector2(x, y)

	if direction.length() > 0.2:
		direction = direction.normalized()
		lantern.global_position = self.global_position+Vector2(x* range, y* range)
		
	
func _physics_process(delta: float) -> void:
	super(delta)
	if aiming==false:
		var direction = Vector2(1,-1)
		direction = direction.normalized()
		lantern.global_position = self.global_position+direction*100
	aiming=false
func auto(aimX: float, aimY: float):
	if cd_rdy(\"auto\"):
		cd_reset(\"auto\")
		var projectile = FIRE_BREEZ.instantiate()
		var direction = Vector2(aimX, aimY).normalized()
		projectile.global_position = global_position + Vector2(aimX*range,aimY*range)

		projectile.rotation = direction.angle() -deg_to_rad(90)

		projectile.direction = direction

		# Ajout à la scène
		get_tree().current_scene.add_child(projectile)
func spell1():
	pass
func spell2():
	pass
"

